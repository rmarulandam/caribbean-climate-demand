{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "release",
    "status",
    "source_commit",
    "release_date",
    "data_release",
    "specification_version",
    "run_ids",
    "gate_evidence",
    "human_approval",
    "allowed_uses",
    "prohibited_interpretations",
    "artifacts",
    "proposal_divergence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release": {
      "type": "string",
      "pattern": "^econ-v\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "withdrawn"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "data_release": {
      "type": "string",
      "minLength": 1
    },
    "specification_version": {
      "type": "string",
      "minLength": 1
    },
    "run_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^RUN-\\d{4,}$"
      }
    },
    "gate_evidence": {
      "type": "object",
      "required": [
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "properties": {
        "E1": {
          "type": "object",
          "required": [
            "by",
            "role",
            "date",
            "evidence"
          ],
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "const": "project_owner"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "E2": {
          "type": "object",
          "required": [
            "by",
            "role",
            "date",
            "evidence"
          ],
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "const": "project_owner"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "E3": {
          "type": "object",
          "required": [
            "by",
            "role",
            "date",
            "evidence"
          ],
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "const": "project_owner"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "E4": {
          "type": "object",
          "required": [
            "by",
            "role",
            "date",
            "evidence"
          ],
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "const": "project_owner"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "human_approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "by",
            "role",
            "date",
            "evidence"
          ],
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "const": "project_owner"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "allowed_uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibited_interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "proposal_divergence": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "human_approval": {
            "type": "object",
            "required": [
              "by",
              "role",
              "date",
              "evidence"
            ],
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "const": "project_owner"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "else": {}
    }
  ]
}
